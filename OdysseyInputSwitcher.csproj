<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>assets\monitor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OdysseyInputSwitcher</AssemblyName>
    <RootNamespace>OdysseyInputSwitcher</RootNamespace>
    <Product>Connected Display Input Selector</Product>
    <AssemblyTitle>Connected Display Input Selector</AssemblyTitle>
    <Description>Select configured inputs on connected DDC/CI displays.</Description>
    <Version>3</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**;tools\**" />
    <EmbeddedResource Include="assets\monitor.ico" />
  </ItemGroup>
</Project>
